generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum CourtType {
  FUTSAL
  BADMINTON
}

enum ReservationStatus {
  PENDING
  DP_PAID
  CANCELED
  DONE
}

enum PaymentStatus {
  PENDING
  VERIFIED
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  phone     String?
  courts    Court[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("venues")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  role          Role      @default(CUSTOMER)
  image         String?

  accounts       Account[]
  sessions       Session[]
  reservations   Reservation[]
  passwordTokens PasswordResetToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Court {
  id           String    @id @default(cuid())
  venueId      String    @map("venue_id")
  name         String
  type         CourtType
  pricePerHour Int       @map("price_per_hour")
  isActive     Boolean   @default(true) @map("is_active")
  imageUrl     String?   @map("image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([venueId])
  @@index([isActive])
  @@map("courts")
}

model Voucher {
  id          String   @id @default(cuid())
  code        String   @unique
  discountPct Int      @map("discount_pct")
  maxDiscount Int?     @map("max_discount")
  minSpend    Int      @default(0) @map("min_spend")
  expiresAt   DateTime @map("expires_at")
  isActive    Boolean  @default(true) @map("is_active")
  // How many non-canceled reservations may redeem this code. Default 1 = single-use.
  maxUses     Int      @default(1) @map("max_uses")

  createdAt    DateTime      @default(now()) @map("created_at")
  reservations Reservation[]

  @@map("vouchers")
}

model Reservation {
  id        String   @id @default(cuid())
  // Dibuat opsional (String?) agar bisa menggunakan onDelete: SetNull
  userId    String?  @map("user_id")
  courtId   String?  @map("court_id")
  voucherId String?  @map("voucher_id")
  date      DateTime @map("date")

  // Perubahan krusial: Menggunakan DateTime untuk waktu mulai dan selesai
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")

  totalPrice      Int               @map("total_price")
  status          ReservationStatus @default(PENDING)
  stripeSessionId String?           @unique @map("stripe_session_id")
  paymentProofUrl String?           @map("payment_proof_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Keamanan Finansial: Ubah Cascade menjadi SetNull
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  court   Court?   @relation(fields: [courtId], references: [id], onDelete: SetNull)
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  payment Payment?

  @@index([courtId, date, startTime, endTime, status])
  @@index([userId, status])
  @@index([voucherId, status])
  @@index([date])
  @@unique([courtId, date, startTime])
  @@map("reservations")
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String        @unique @map("reservation_id")
  dpAmount      Int           @map("dp_amount")
  status        PaymentStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Payment tetap Cascade terhadap Reservation. Jika reservasi dihapus paksa, pembayarannya ikut terhapus.
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model Setting {
  id                Int    @id @default(1)
  venueName         String
  operationalHours  String
  contactPhone      String
  dpPercentage      Int    @default(50)
  autoCancelTimeout Int    @default(15)
  notifyEmail       String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [email], references: [email], onDelete: Cascade)

  @@unique([email, token])
  @@map("password_reset_tokens")
}
