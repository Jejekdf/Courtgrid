# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase (Realtime, Storage & Admin)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# Modern publishable key (sb_publishable_...). Server-side Supabase clients.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# JWKS URL for validating Supabase Auth JWT. Get it from Dashboard → Settings → API.
SUPABASE_JWKS_URL="https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"
# Legacy anon JWT (eyJ...). REQUIRED for Realtime: the Realtime websocket endpoint
# rejects the modern publishable key (HTTP 401); only the anon JWT authorizes
# postgres_changes subscriptions. Get it from Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Server-only service-role key. NEVER exposed to the browser. Used by lib/supabase/storage.ts (admin client).
SUPABASE_SECRET_KEY="sb_secret_..."

# NextAuth Configuration
AUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-a-secure-secret-key-here"

# NextAuth OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_CLIENT_ID="your-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-facebook-client-secret"

# Resend Email Configuration
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="CourtGrid <noreply@courtgridd.com>"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Super Admin Credentials (for seed/login)
ADMIN_EMAIL="admin@courtgrid.com"
ADMIN_PASSWORD="CHANGE_ME_use_strong_password"
ADMIN_NAMA="CourtGrid Superadmin"

# Seed Demo Data (set to "true" to create dev customer + demo reservations)
SEED_DEMO="false"

# Upstash Redis Configuration (for Rate Limiting & Data Caching)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# Vercel Cron Secret (for securing proactive cleanup cron jobs)
CRON_SECRET="your-vercel-cron-secret"

